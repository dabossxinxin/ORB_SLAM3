{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "stereo_inertial_realsense_D435i",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Examples/Stereo-Inertial/stereo_inertial_realsense_D435i",
            "args": [
                "${workspaceFolder}/Vocabulary/ORBvoc.txt",
                "${workspaceFolder}/Examples/Stereo-Inertial/RealSense_D435i.yaml",
                "${workspaceFolder}/Examples/Stereo-Inertial/"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}